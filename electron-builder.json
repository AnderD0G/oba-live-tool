{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.local.oba.codexdraft",
  "npmRebuild": false,
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "electronLanguages": ["zh-CN", "en-US"],
  "files": ["dist-electron", "dist"],
  "extraResources": [
    { "from": "vendor-build/codex/package", "to": "codex" },
    { "from": "INSTALL-GUIDE.txt", "to": "INSTALL-GUIDE.txt" }
  ],
  "mac": {
    "artifactName": "${productName}_${version}_macos_${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "public/favicon.png"
  },
  "win": {
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico",
    "artifactName": "${productName}_${version}_windows_${arch}.${ext}"
  },
  "nsis": {
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "OBA 弹幕与打印",
    "installerLanguages": ["zh_CN", "en_US"],
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "differentialPackage": false
  }
}
